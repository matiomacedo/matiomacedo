<svg xmlns="http://www.w3.org/2000/svg" width="340" height="532" viewBox="0 0 340 532" role="img" aria-labelledby="t">
  <title id="t">ana takes the task "Add input validation to the signup endpoint and run the tests": it plans, edits two files, verifies with pytest (12 passed) and remembers what it learned.</title>
  <style>
    @font-face { font-family: "SG"; font-weight: 400; src: url(data:font/woff2;base64,$sg400) format("woff2"); }
    @font-face { font-family: "SG"; font-weight: 700; src: url(data:font/woff2;base64,$sg700) format("woff2"); }
    @font-face { font-family: "JBM"; font-weight: 400; src: url(data:font/woff2;base64,$jbm400) format("woff2"); }

    text { font-family: "SG", -apple-system, "Segoe UI", sans-serif; fill: $ink; }
    .mark { font-weight: 700; font-size: 64px; letter-spacing: -1.3px; }
    .code { font-family: "JBM", ui-monospace, Menlo, monospace; font-size: 14px; }
    .phase { font-size: 15px; fill: $muted; }
    .detail { font-size: 16px; }
    .caption { font-size: 17px; }
    .muted { fill: $muted; }
    .violet { fill: $violet; }
    .pass { fill: $pass; }
    .rule { stroke: $rule; stroke-width: 1; }
    .spine { stroke: $rule; stroke-width: 2; }
    .node { fill: $bg; stroke: $muted; stroke-width: 2; }
    .node-last { fill: $violet; }

    .step { opacity: 0; animation: in 0.45s ease-out forwards; }
    .s1 { animation-delay: 0.3s; }
    .s2 { animation-delay: 1.0s; }
    .s3 { animation-delay: 1.7s; }
    .s4 { animation-delay: 2.4s; }
    .s5 { animation-delay: 3.1s; }
    .spine { stroke-dasharray: 226; stroke-dashoffset: 226; animation: draw 2.1s linear 0.9s forwards; }
    @keyframes in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @media (prefers-reduced-motion: reduce) {
      .step, .spine { animation: none; opacity: 1; stroke-dashoffset: 0; }
    }
  </style>

  <text class="mark" x="-3" y="58">ana</text>
  <line class="rule" x1="0" y1="82" x2="340" y2="82"/>

  <g class="step s1">
    <text class="code" x="0" y="112"><tspan class="violet">❯</tspan> Add input validation to the signup<tspan x="17" dy="20">endpoint and run the tests</tspan></text>
  </g>

  <line class="spine" x1="7" y1="168" x2="7" y2="394"/>

  <g class="step s2">
    <circle class="node" cx="7" cy="168" r="5"/>
    <text class="phase" x="24" y="173">plans</text>
    <text class="detail" x="24" y="196">Reads <tspan class="code">routes/signup.py</tspan> and the user<tspan x="24" dy="20">schema, proposes two changes</tspan></text>
  </g>
  <g class="step s3">
    <circle class="node" cx="7" cy="250" r="5"/>
    <text class="phase" x="24" y="255">edits</text>
    <text class="detail" x="24" y="278"><tspan class="code">routes/signup.py</tspan>,<tspan class="code" x="24" dy="20">tests/test_signup.py</tspan></text>
  </g>
  <g class="step s4">
    <circle class="node" cx="7" cy="332" r="5"/>
    <text class="phase" x="24" y="337">verifies</text>
    <text class="detail" x="24" y="360"><tspan class="code">pytest</tspan><tspan class="code pass" dx="12">12 passed</tspan></text>
  </g>
  <g class="step s5">
    <circle class="node-last" cx="7" cy="394" r="6"/>
    <text class="phase" x="24" y="399">remembers</text>
    <text class="detail" x="24" y="422">Signup validation lives in the request<tspan x="24" dy="20">model, not the route</tspan></text>
  </g>

  <line class="rule" x1="0" y1="470" x2="340" y2="470"/>
  <text class="caption muted" x="0" y="498">An AI coding agent that plans before<tspan x="0" dy="22">it touches your code.</tspan></text>
</svg>
